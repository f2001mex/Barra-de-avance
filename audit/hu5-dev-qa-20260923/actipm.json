  "validationRule": {
    "active": true,
    "errorConditionFormula": "AND(\n    RecordType.DeveloperName = \"Oportunidad_Personas_Morales\",\n    NOT(ISNEW()),\n    ISCHANGED(StageName),\n    OR(\n        ISPICKVAL(StageName,\"Closed Won\"),\n        ISPICKVAL(StageName,\"Closed Lost\")\n    ),\n    PRIORVALUE(OwnerId) <> $User.Id,\n    $UserRole.DeveloperName <> \"Head_PM\"\n)"
  },
