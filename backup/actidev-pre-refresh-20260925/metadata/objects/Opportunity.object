    <fields>
        <fullName>Profit_and_Loss_PM__c</fullName>
        <label>Profit and Loss (P&amp;L)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <validationRules>
        <fullName>PM_OPP_Account_Requerida</fullName>
        <active>true</active>
        <description>HU1 PM - CA01/RV01 Oportunidades: Cliente asociado obligatorio para Opportunity PM.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Oportunidad_Personas_Morales&quot;,
    ISBLANK(AccountId)
)</errorConditionFormula>
        <errorDisplayField>AccountId</errorDisplayField>
        <errorMessage>Relaciona la oportunidad con un cliente.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PM_OPP_CloseDate_Valida</fullName>
        <active>true</active>
        <description>HU1 PM - CA03/RV07 Oportunidades: Fecha de cierre no puede ser anterior a la fecha de creacion.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Oportunidad_Personas_Morales&quot;,
    CloseDate &lt; IF(ISNEW(), TODAY(), DATEVALUE(CreatedDate))
)</errorConditionFormula>
        <errorDisplayField>CloseDate</errorDisplayField>
        <errorMessage>La fecha de cierre no puede ser anterior a la fecha de creación de la oportunidad.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PM_OPP_Especifica_Otro</fullName>
        <active>true</active>
        <description>HU1 PM - CA05/RV05: Especifica Otro obligatorio cuando Producto Solicitado es Other.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Oportunidad_Personas_Morales&quot;,
    ISPICKVAL(Producto_Solicitado__c, &quot;Other&quot;),
    ISBLANK(Especifica_Otro_Producto__c)
)</errorConditionFormula>
        <errorDisplayField>Especifica_Otro_Producto__c</errorDisplayField>
        <errorMessage>Especifica el producto cuando selecciones Other.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PM_OPP_Monto_Mayor_Cero</fullName>
        <active>true</active>
        <description>HU1 PM - RV06 Oportunidades: monto obligatorio y mayor a cero para Opportunity PM.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Oportunidad_Personas_Morales&quot;,
    OR(
        ISBLANK(MontoEstimadoDeInversion__c),
        MontoEstimadoDeInversion__c &lt;= 0
    )
)</errorConditionFormula>
        <errorDisplayField>MontoEstimadoDeInversion__c</errorDisplayField>
        <errorMessage>El monto debe ser un valor positivo mayor a cero.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PM_OPP_Motivo_Perdida_PM</fullName>
        <active>true</active>
        <description>HU1 PM - RN05 Opportunity: motivo de pérdida abierto obligatorio cuando la Opportunity PM está Closed Lost.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Oportunidad_Personas_Morales&quot;,
    ISPICKVAL(StageName, &quot;Closed Lost&quot;),
    ISBLANK(TEXT(Motivo_de_perdidaPM__c))
)</errorConditionFormula>
        <errorDisplayField>Motivo_de_perdidaPM__c</errorDisplayField>
        <errorMessage>Captura el motivo de pérdida.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PM_OPP_No_Reabrir_Cerrada</fullName>
        <active>true</active>
        <description>HU1 PM - RN04 Opportunity: no permitir reabrir una Opportunity PM cuando ya estaba Closed Won o Closed Lost.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Oportunidad_Personas_Morales&quot;,
    NOT(ISNEW()),
    ISCHANGED(StageName),
    OR(
        ISPICKVAL(PRIORVALUE(StageName), &quot;Closed Won&quot;),
        ISPICKVAL(PRIORVALUE(StageName), &quot;Closed Lost&quot;)
    ),
    NOT(
        OR(
            ISPICKVAL(StageName, &quot;Closed Won&quot;),
            ISPICKVAL(StageName, &quot;Closed Lost&quot;)
        )
    )
)</errorConditionFormula>
        <errorDisplayField>StageName</errorDisplayField>
        <errorMessage>No puedes reabrir una oportunidad cerrada.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PM_OPP_Producto_Requerido</fullName>
        <active>true</active>
        <description>HU1 PM - RV04 Oportunidades: Producto obligatorio para Opportunity PM.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Oportunidad_Personas_Morales&quot;,
    ISBLANK(TEXT(Producto_Solicitado__c))
)</errorConditionFormula>
        <errorDisplayField>Producto_Solicitado__c</errorDisplayField>
        <errorMessage>Selecciona un producto.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PM_OPP_Solo_Owner_Cierra</fullName>
        <active>true</active>
        <description>HU1 PM - RN04 Opportunity: solo el propietario puede cambiar una Opportunity PM a Closed Won o Closed Lost.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Oportunidad_Personas_Morales&quot;,
    NOT(ISNEW()),
    ISCHANGED(StageName),
    OR(
        ISPICKVAL(StageName,&quot;Closed Won&quot;),
        ISPICKVAL(StageName,&quot;Closed Lost&quot;)
    ),
    PRIORVALUE(OwnerId) &lt;&gt; $User.Id,
    $UserRole.DeveloperName &lt;&gt; &quot;Head_PM&quot;
)</errorConditionFormula>
        <errorDisplayField>StageName</errorDisplayField>
        <errorMessage>Solo el propietario puede cerrar la oportunidad.</errorMessage>
    </validationRules>
</CustomObject>
