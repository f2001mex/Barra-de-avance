    <fields>
        <fullName>PatriMinutosEntreAsignadaRecalendarizada__c</fullName>
        <externalId>false</externalId>
        <formula>( PatrimFechaDeRecalendarizaci_n__c - PatrimFechaAsignadaOportunidad__c )  * 1440</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Minutos entre signado y recalendarizada</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
