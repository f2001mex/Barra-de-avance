    <fields>
        <fullName>Tipo__c</fullName>
        <externalId>false</externalId>
        <formula>IF(RecordType.Name == &apos;Patrimonial&apos;  &amp;&amp; (ISPICKVAL(StageName, &quot;Cerrada Ganada&quot;)),
          &apos;Cliente&apos;,
       IF((RecordType.Name == &apos;Patrimonial&apos; || RecordType.Name ==&apos;&apos; )  &amp;&amp; (ISPICKVAL(StageName, &quot;Cerrada Perdida&quot;)),
          &apos;Descartado&apos;,
          IF(RecordType.Name == &apos;Patrimonial&apos;  &amp;&amp; !(ISPICKVAL(StageName, &quot;Cerrada Ganada&quot;) || ISPICKVAL(StageName, &quot;Cerrada Perdida&quot;)),
       &apos;Prospecto&apos;, &apos;&apos;
        )
        
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Tipo</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
