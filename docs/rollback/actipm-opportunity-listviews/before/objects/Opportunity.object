    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>CerradaPerdida_RazonDeLaPerdida_Obligat</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISPICKVAL(StageName, &quot;Cerrada Perdida&quot;),
    ISPICKVAL(Razon_de_la_perdida__c, &quot;&quot;),
    OR(
        RecordType.DeveloperName = &apos;Financiamiento&apos;,
        RecordType.DeveloperName = &apos;Insurance&apos;,
RecordType.DeveloperName = &apos;WalletShareOpportunity&apos;,
RecordType.DeveloperName = &apos;Casa_de_Bolsa&apos;,
RecordType.DeveloperName = &apos;Financiamiento&apos;,
RecordType.DeveloperName = &apos;Planes_Beneficio_Fiscal&apos;,
RecordType.DeveloperName = &apos;General&apos;,
RecordType.DeveloperName = &apos;Presentación de oferta&apos;
    )
)</errorConditionFormula>
        <errorMessage>Favor de ingresar &quot;Razón de la perdida&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Cliente_Si_aceptaOferta</fullName>
        <active>true</active>
        <description>Si el cliente NO acepta oferta se debe habilitar el campo “Siguientes pasos” el cual será obligatorio</description>
        <errorConditionFormula>and(ISPICKVAL(Cliente_Acepta_oferta__c,&apos;NO&apos;), ISBLANK(text(Siguientes_pasos__c)))</errorConditionFormula>
        <errorMessage>Debes completar el campo &apos;Siguientes pasos&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Cliente_no_interesado</fullName>
        <active>false</active>
        <description>Regla para validar que el motivo de No interés, sea llenado cuando el cliente no esta interesado.</description>
        <errorConditionFormula>AND(
  ISPICKVAL(Cliente_interesado__c, &quot;NO&quot;),
  ISBLANK(Motivo_No_Interesado__c)
)</errorConditionFormula>
        <errorDisplayField>Motivo_No_Interesado__c</errorDisplayField>
        <errorMessage>Por favor, indica el motivo por el cual el cliente no está interesado.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CodigodeInvitadoRequerido</fullName>
        <active>true</active>
        <description>Si se completa una línea de eventos en el campo Primary Campaign Source, se debe completar el campo Código de invitado (esta regla aplica solo a Asesor Privada).</description>
        <errorConditionFormula>AND(
 ISBLANK(Cod_Inv__c),
 NOT( ISBLANK( L_nea_de_acci_n__c )),
	ISPICKVAL(L_nea_de_acci_n__r.Type, &quot;Event&quot;),
	$Profile.Name = &quot;Asesor Privada&quot; 
)</errorConditionFormula>
        <errorDisplayField>Cod_Inv__c</errorDisplayField>
        <errorMessage>Por favor completar el campo &quot;Código Invitado&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>F3_Cerrada_Ganada_Perdida_Op</fullName>
        <active>true</active>
        <description>Regla de validación donde se bloqueara el movimiento a otras etapas al llegar a estas (cerrada ganada o cerrada perdida)</description>
        <errorConditionFormula>OR(
   AND(
       ISPICKVAL(PRIORVALUE(StageName), &apos;Cerrada Ganada&apos;),
       NOT(ISPICKVAL(StageName, &apos;Cerrada Ganada&apos;)),
							 RecordType.Name  &lt;&gt; &quot;Patrimonial&quot;,
       NOT($Permission.bypassValidationRules)             
       ),
   AND(
       ISPICKVAL(PRIORVALUE(StageName), &apos;Cerrada Perdida&apos;),
       NOT(ISPICKVAL(StageName, &apos;Cerrada Perdida&apos;)),
							RecordType.Name  &lt;&gt; &quot;Patrimonial&quot;,
       NOT($Permission.bypassValidationRules)
))</errorConditionFormula>
        <errorMessage>Al llegar a esta etapa no es posible cambiar el estatus.
Nota: Si es un caso extraordinario, favor de contactar al Administrador para revisar el caso.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>F3_Contacto_Inicial_Op</fullName>
        <active>true</active>
        <description>Regla de validación para que el usuario no pueda avanzar a la siguiente etapa hasta haber completado los campos de contacto inicial (con excepción de &apos;elementos de presentación&apos; ya que es multipicklist y Campaña porque no es obligatorio)</description>
        <errorConditionFormula>IF(
    ISCHANGED(StageName) &amp;&amp;
    NOT(
        OR(
            RecordType.DeveloperName = &apos;Financiamiento&apos;,
            RecordType.DeveloperName = &apos;Seguros_Pipeline&apos;,
            RecordType.DeveloperName = &apos;Oportunidad_Personas_Fisicas&apos;,
            RecordType.DeveloperName = &apos;Oportunidad_Seguro_Via&apos;,
            RecordType.DeveloperName = &apos;Oportunidad_Seguro_Hogar&apos;,
            RecordType.DeveloperName = &apos;Oportunidad_Seguro_Dotales&apos;
        )
    )
    &amp;&amp; ISPICKVAL(PRIORVALUE(StageName), &apos;Contacto Inicial&apos;)
    &amp;&amp; NOT($Permission.bypassValidationRules),
    IF(
        ISPICKVAL(PRIORVALUE(StageName), &apos;Contacto Inicial&apos;)
        &amp;&amp;
        ISPICKVAL(StageName, &apos;Identificar Necesidades&apos;),
        IF(Cliente_Contactado__c = TRUE, FALSE, TRUE),
        TRUE
    ),
    FALSE
)</errorConditionFormula>
        <errorMessage>Favor de completar los campos necesarios para poder avanzar a la siguiente etapa: &apos;Identificar Necesidades&apos;
Nota: No podrás avanzar a otra etapa diferente a Identificar Necesidades</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>F3_Formalizacion_Validacion_Op</fullName>
        <active>true</active>
        <description>Regla de validación para que el usuario no pueda avanzar a la siguiente etapa hasta haber recibido la bandera de creación de Contrato</description>
        <errorConditionFormula>OR(
AND(
    ISPICKVAL(PRIORVALUE(StageName), &apos;Formalización y Validación&apos;),
       Contrato_Creado__c  = FALSE,
    ISPICKVAL(StageName, &apos;Cerrada Ganada&apos;),
OR(RecordType.DeveloperName = &apos;Casa_de_Bolsa&apos;,
    RecordType.DeveloperName = &apos;Planes_Beneficio_Fiscal&apos;,	 
    RecordType.DeveloperName = &apos;WalletShareOpportunity&apos;), 
    NOT($Permission.bypassValidationRules)
    ),
AND(
    ISPICKVAL(PRIORVALUE(StageName), &apos;Formalización y Validación&apos;),
    NOT(ISPICKVAL(StageName, &apos;Formalización y Validación&apos;)),
    NOT(ISPICKVAL(StageName, &apos;Cerrada Ganada&apos;)),
    NOT(ISPICKVAL(StageName, &apos;Cerrada Perdida&apos;)),
     OR(RecordType.DeveloperName = &apos;Casa_de_Bolsa&apos;,
    RecordType.DeveloperName = &apos;Planes_Beneficio_Fiscal&apos;, 
    RecordType.DeveloperName = &apos;WalletShareOpportunity&apos;), 
    NOT($Permission.bypassValidationRules)
))</errorConditionFormula>
        <errorMessage>Esperar a la creación del contrato en SAP para poder avanzar a la siguiente etapa
Nota: No podrás avanzar a otra etapa diferente a &apos;Cerrada Ganada&apos; o &apos;Cerrada Perdida&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>F3_Formalizacion_Validacion_OpFin</fullName>
        <active>true</active>
        <description>Regla de validación para que el usuario no pueda avanzar a la siguiente etapa hasta haber recibido la bandera de creación de Crédito</description>
        <errorConditionFormula>OR(
AND(
    ISPICKVAL(PRIORVALUE(StageName), &apos;Formalización y Validación&apos;),
    OR(
        ISPICKVAL(Credito_Creado__c,&apos;&apos;)
       ),
    ISPICKVAL(StageName, &apos;Cerrada Ganada&apos;),
    NOT($Permission.bypassValidationRules),
    RecordType.DeveloperName = &apos;Financiamiento&apos;
    ),
AND(
    ISPICKVAL(PRIORVALUE(StageName), &apos;Formalización y Validación&apos;),
    NOT(ISPICKVAL(StageName, &apos;Formalización y Validación&apos;)),
    NOT(ISPICKVAL(StageName, &apos;Cerrada Ganada&apos;)),
    NOT(ISPICKVAL(StageName, &apos;Cerrada Perdida&apos;)),
    RecordType.DeveloperName = &apos;Financiamiento&apos;,
    NOT($Permission.bypassValidationRules)
))</errorConditionFormula>
        <errorMessage>Esperar a la creación del crédito para poder avanzar a la siguiente etapa
Nota: No podrás avanzar a otra etapa diferente a &apos;Cerrada Ganada&apos; o &apos;Cerrada Perdida&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>F3_Formalizacion_Validacion_Seg</fullName>
        <active>true</active>
        <description>Regla de validación para que el usuario no pueda avanzar a la siguiente etapa hasta haber recibido la bandera de creación de Póliza</description>
        <errorConditionFormula>OR(
AND(
    ISPICKVAL(PRIORVALUE(StageName), &apos;Formalización y Validación&apos;),
    OR(
       Poliza_de_Seguros_Creada__c  = FALSE,
        ISBLANK(F3_No_Poliza_Seguros__c) 
       ),
    ISPICKVAL(StageName, &apos;Cerrada Ganada&apos;),
    RecordType.DeveloperName = &apos;Insurance&apos;,
    NOT($Permission.bypassValidationRules)
    ),
AND(
    ISPICKVAL(PRIORVALUE(StageName), &apos;Formalización y Validación&apos;),
    NOT(ISPICKVAL(StageName, &apos;Formalización y Validación&apos;)),
    NOT(ISPICKVAL(StageName, &apos;Cerrada Ganada&apos;)),
    NOT(ISPICKVAL(StageName, &apos;Cerrada Perdida&apos;)),
    NOT(ISPICKVAL(StageName, &apos;Recalendarización&apos;)),
    RecordType.DeveloperName = &apos;Insurance&apos;,
    NOT($Permission.bypassValidationRules)
))</errorConditionFormula>
        <errorMessage>Esperar a la creación de la póliza de seguros y agregar el no. de póliza relacionada a la oportunidad para poder avanzar a la siguiente etapa
Nota: No podrás avanzar a otra etapa diferente a &apos;Cerrada Ganada&apos; &apos;Cerrada Perdida&apos; o &apos;Recalendarización&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>F3_Identificacion_Necesidades_Seg</fullName>
        <active>true</active>
        <description>Usada para validar los datos requeridos para la identificación de necesidades</description>
        <errorConditionFormula>OR(
AND(
  NOT(ISNEW()),
  OR(
    ISPICKVAL(Unidad_de_Negocio__c, &apos;&apos;),
    ISPICKVAL(Productos_ofertados__c, &apos;&apos;),
    ISPICKVAL(Sub_Ramo__c, &apos;&apos;)
  ),
  ISPICKVAL(PRIORVALUE(StageName), &apos;Identificar Necesidades&apos;),
  ISPICKVAL(StageName, &apos;Formalización y Validación&apos;),
  RecordType.DeveloperName = &apos;Insurance&apos;,
  NOT($Permission.bypassValidationRules)
),
AND(
    ISPICKVAL(PRIORVALUE(StageName), &apos;Identificar Necesidades&apos;),
    NOT(ISPICKVAL(StageName, &apos;Identificar Necesidades&apos;)),
    NOT(ISPICKVAL(StageName, &apos;Formalización y Validación&apos;)),
    NOT(ISPICKVAL(StageName, &apos;Recalendarización&apos;)),
    NOT(ISPICKVAL(StageName, &apos;Cerrada Perdida&apos;)),
    RecordType.DeveloperName = &apos;Insurance&apos;,
    NOT($Permission.bypassValidationRules)
    )
  )</errorConditionFormula>
        <errorMessage>Favor de completar los campos de &apos;Unidad de Negocio, Productos ofertados, Sub Ramo para avanzar a &apos;Formalización y Validación&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>F3_Presentacion_de_Oferta_CByPS</fullName>
        <active>true</active>
        <description>Regla de validación para que el usuario complete todos los campos mínimos requeridos de la sección de Presentación de Oferta</description>
        <errorConditionFormula>OR(
AND(
ISPICKVAL(PRIORVALUE(StageName), &apos;Presentación de oferta&apos;),
ISPICKVAL( StageName, &apos;Formalización y Validación&apos;),
F3_isCreatedInSAP__c = false,
AND(OR(RecordType.DeveloperName = &apos;Casa_de_Bolsa&apos;,
RecordType.DeveloperName =&apos;Planes_Beneficio_Fiscal&apos;,
RecordType.DeveloperName = &apos;WalletShareOpportunity&apos;),
								RecordType.DeveloperName &lt;&gt; &apos;Patrimonial&apos; ,

NOT($Permission.bypassValidationRules))

),
AND(
								RecordType.DeveloperName &lt;&gt; &apos;Patrimonial&apos; ,

ISPICKVAL(PRIORVALUE(StageName), &apos;Presentación de oferta&apos;),
NOT(ISPICKVAL(StageName, &apos;Presentación de oferta&apos;)),
NOT(ISPICKVAL(StageName, &apos;Formalización y Validación&apos;)),
NOT(ISPICKVAL(StageName, &apos;Identificar Necesidades&apos;)),
NOT(ISPICKVAL(StageName, &apos;Cerrada Perdida&apos;)),
NOT(ISPICKVAL(StageName, &apos;Recalendarización&apos;)),
NOT($Permission.bypassValidationRules)
)
)</errorConditionFormula>
        <errorMessage>Favor de esperar a que se haya creado el contrato en SAP, para poder avanzar a la siguiente etapa.
Nota: No podrás avanzar a otra etapa diferente a &apos;Formalización y Validación&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>F3_Presentacion_de_Oferta_Op</fullName>
        <active>true</active>
        <description>Regla de validación para que el usuario complete todos los campos mínimos requeridos de la sección de Presentación de Oferta</description>
        <errorConditionFormula>OR(
AND(
								RecordType.DeveloperName &lt;&gt; &apos;Patrimonial&apos; ,

ISPICKVAL(PRIORVALUE(StageName), &apos;Presentación de oferta&apos;),
ISPICKVAL( StageName, &apos;Formalización y Validación&apos;),
OR(
ISPICKVAL(Cliente_Acepta_oferta__c, &apos;&apos;),
ISPICKVAL(Cliente_Acepta_oferta__c, &apos;NO&apos;),
AND(
ISPICKVAL(Cliente_Acepta_oferta__c, &apos;NO&apos;),
ISPICKVAL(Siguientes_pasos__c, &apos;&apos;),
NOT($Permission.bypassValidationRules)
)
)
),
AND(
								RecordType.DeveloperName &lt;&gt; &apos;Patrimonial&apos; ,

ISPICKVAL(PRIORVALUE(StageName), &apos;Presentación de oferta&apos;),
NOT(ISPICKVAL(StageName, &apos;Presentación de oferta&apos;)),
NOT(ISPICKVAL(StageName, &apos;Formalización y Validación&apos;)),
NOT(ISPICKVAL(StageName, &apos;Identificar Necesidades&apos;)),
NOT(ISPICKVAL(StageName, &apos;Cerrada Perdida&apos;)),
NOT(ISPICKVAL(StageName, &apos;Recalendarización&apos;)),
NOT($Permission.bypassValidationRules)
))</errorConditionFormula>
        <errorMessage>Favor de seleccionar una opción, para poder avanzar a la siguiente etapa.
Nota: No podrás avanzar a otra etapa diferente a &apos;Formalización y Validación&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>F3_Solicitar_Documentacion_Seg</fullName>
        <active>false</active>
        <description>Regla de validación para que el usuario complete todos los campos mínimos requeridos de la sección cotización de póliza de seguros</description>
        <errorConditionFormula>OR(
AND(
  ISPICKVAL(PRIORVALUE(StageName), &apos;Solicitar documentación&apos;),
  OR(
      ISBLANK(F3_Apellido_Materno__c),
      ISBLANK(F3_Nombre_Asegurado__c),
      ISBLANK(F3_Apellido_Materno_Asegurado__c),
      ISBLANK(F3_Apellido_Paterno_Asegurado__c),
      ISBLANK(F3_RFC__c),
      ISBLANK(F3_Email__c),
      F3_Se_completaron_campos_mInimos__c  = FALSE
     ),
  ISPICKVAL(StageName, &apos;Formalización y Validación&apos;),
  RecordType.DeveloperName = &apos;Insurance&apos;,
  NOT($Permission.bypassValidationRules) 
  ),
AND(
      ISPICKVAL( PRIORVALUE(StageName), &apos;Solicitar documentación&apos;),
      NOT ( ISPICKVAL(StageName, &apos;Solicitar documentación&apos;)),
NOT ( ISPICKVAL(StageName, &apos;Cerrada Perdida&apos;)),
      NOT ( ISPICKVAL(StageName, &apos;Formalización y Validación&apos;)),
      RecordType.DeveloperName = &apos;Insurance&apos;,
      NOT($Permission.bypassValidationRules)
     )
)</errorConditionFormula>
        <errorMessage>Favor de completar todos los campos requeridos de la sección campos cotización de póliza de seguros para poder solicitar la creación de póliza de seguros
Nota: No podrás avanzar a otra etapa diferente a Formalización y Validación.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>F3_Validar_Identificacion_Necesidades_FI</fullName>
        <active>true</active>
        <description>Usada para validar los datos requeridos para la identificación de necesidades</description>
        <errorConditionFormula>OR(
AND(
  NOT(ISNEW()),
  OR(
    ISPICKVAL(Unidad_de_Negocio__c, &apos;&apos;),
    ISPICKVAL(Productos_ofertados__c, &apos;&apos;)
  ),
  ISPICKVAL(PRIORVALUE(StageName), &apos;Identificar Necesidades&apos;),
  ISPICKVAL(StageName, &apos;Presentación de oferta&apos;),
  RecordType.DeveloperName = &apos;Financiamiento&apos;,
  NOT($Permission.bypassValidationRules)

),
AND(
    ISPICKVAL(PRIORVALUE(StageName), &apos;Identificar Necesidades&apos;),
    NOT(ISPICKVAL(StageName, &apos;Identificar Necesidades&apos;)),    
    NOT(ISPICKVAL(StageName, &apos;Presentación de oferta&apos;)),
    NOT(ISPICKVAL(StageName, &apos;Cerrada Perdida&apos;)),
    RecordType.DeveloperName = &apos;Financiamiento&apos;,
    NOT($Permission.bypassValidationRules)
    )
  )</errorConditionFormula>
        <errorMessage>Favor de completar los campos de Unidad de Negocio y Productos ofertados para avanzar a &apos;Presentación de Oferta&apos;
Nota: No podrás avanzar a otra etapa diferente a &apos;Presentación de Oferta&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>F3_Validar_Identificacion_Necesidades_Op</fullName>
        <active>true</active>
        <description>Usada para validar los datos requeridos para la identificación de necesidades</description>
        <errorConditionFormula>OR(
AND(
  NOT(ISNEW()),
  OR(
    ISPICKVAL(Unidad_de_Negocio__c, &apos;&apos;),
    ISPICKVAL(Productos_ofertados__c, &apos;&apos;),
    ISPICKVAL(Sub_Ramo__c, &apos;&apos;)
  ),
  ISPICKVAL(PRIORVALUE(StageName), &apos;Identificar Necesidades&apos;),
  ISPICKVAL(StageName, &apos;Presentación de oferta&apos;),
  OR(RecordType.DeveloperName = &apos;Casa_de_Bolsa&apos;,
     RecordType.DeveloperName = &apos;Planes_Beneficio_Fiscal&apos;, 
     RecordType.DeveloperName = &apos;WalletShareOpportunity&apos;,
				 RecordType.DeveloperName = &apos;Patrimonial&apos;)
),
AND(
    ISPICKVAL(PRIORVALUE(StageName), &apos;Identificar Necesidades&apos;),
    NOT(ISPICKVAL(StageName, &apos;Identificar Necesidades&apos;)),
    NOT(ISPICKVAL(StageName, &apos;Presentación de oferta&apos;)),
    OR(RecordType.DeveloperName = &apos;Casa_de_Bolsa&apos;,
    RecordType.DeveloperName = &apos;Planes_Beneficio_Fiscal&apos;, 
    RecordType.DeveloperName = &apos;WalletShareOpportunity&apos;,	
				RecordType.DeveloperName = &apos;Patrimonial&apos;),
				NOT($Permission.bypassValidationRules)
    )
  )</errorConditionFormula>
        <errorMessage>Favor de completar los campos de &apos;Unidad de Negocio, Productos ofertados, Sub Ramo para avanzar a &apos;Presentación de Oferta&apos;
Nota: No podrás avanzar a otra etapa diferente a &apos;Presentación de Oferta&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>FinServ__NonPortalUserReferrer</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
                NOT(ISBLANK(FinServ__ReferredByUser__c)),
                NOT(ISPICKVAL(FinServ__ReferredByUser__r.UserType, &apos;Standard&apos;))
            )</errorConditionFormula>
        <errorDisplayField>FinServ__ReferredByUser__c</errorDisplayField>
        <errorMessage>Internal referrers must be internal Salesforce users.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>FinServ__SingleReferredByEntryByRecord</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
        NOT(ISBLANK( FinServ__ReferredByUser__c )), 
        NOT(ISBLANK( FinServ__ReferredByContact__c )) 
    )</errorConditionFormula>
        <errorDisplayField>FinServ__ReferredByContact__c</errorDisplayField>
        <errorMessage>Enter an internal referrer or an external referrer. You can list only one referrer for each referral.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LineOfAction_Inactive</fullName>
        <active>true</active>
        <errorConditionFormula>Campaign.IsActive =false</errorConditionFormula>
        <errorDisplayField>CampaignId</errorDisplayField>
        <errorMessage>Sólo se pueden asignar campañas vigentes</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>NoEditarOpportunidadCerradaPerdidaGanada</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
 NOT(ISNEW()),
 NOT(PatrimExcluirFlow__c),
 NOT(ISCHANGED(PatrimExcluirFlow__c)),
 NOT(
   AND(
     ISCHANGED(StageName),
     $Permission.Patrim_Reabrir_Oportunidad_Cerrada
   )
 ),
 OR(
   RecordType.Name = &quot;Wealt Management&quot;,
   RecordType.Name = &quot;Privada&quot;,
   RecordType.Name = &quot;Patrimonial&quot;
 ),
 OR(
   ISPICKVAL(PRIORVALUE(StageName),&apos;Cerrada Ganada&apos;),
   ISPICKVAL(PRIORVALUE(StageName),&apos;Cerrada Perdida&apos;)
 )
)</errorConditionFormula>
        <errorMessage>No puedes modificar la oportunidad una vez cerrada.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PM_OPP_Account_Requerida</fullName>
        <active>true</active>
        <description>HU1 PM - CA01/RV01 Oportunidades: Cliente asociado obligatorio para Opportunity PM.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Oportunidad_Personas_Morales&quot;,
    ISBLANK(AccountId)
)</errorConditionFormula>
        <errorDisplayField>AccountId</errorDisplayField>
        <errorMessage>Relaciona la oportunidad con un cliente.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PM_OPP_CloseDate_Valida</fullName>
        <active>true</active>
        <description>HU1 PM - CA03/RV07 Oportunidades: Fecha de cierre no puede ser anterior a la fecha de creacion.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Oportunidad_Personas_Morales&quot;,
    CloseDate &lt; IF(ISNEW(), TODAY(), DATEVALUE(CreatedDate))
)</errorConditionFormula>
        <errorDisplayField>CloseDate</errorDisplayField>
        <errorMessage>La fecha de cierre no puede ser anterior a la fecha de creación de la oportunidad.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PM_OPP_Especifica_Otro</fullName>
        <active>true</active>
        <description>HU1 PM - CA05/RV05: Especifica Otro obligatorio cuando Producto Solicitado es Other.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Oportunidad_Personas_Morales&quot;,
    ISPICKVAL(Producto_Solicitado__c, &quot;Other&quot;),
    ISBLANK(Especifica_Otro_Producto__c)
)</errorConditionFormula>
        <errorDisplayField>Especifica_Otro_Producto__c</errorDisplayField>
        <errorMessage>Especifica el producto cuando selecciones Other.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PM_OPP_Monto_Mayor_Cero</fullName>
        <active>true</active>
        <description>HU1 PM - RV06 Oportunidades: monto obligatorio y mayor a cero para Opportunity PM.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Oportunidad_Personas_Morales&quot;,
    OR(
        ISBLANK(MontoEstimadoDeInversion__c),
        MontoEstimadoDeInversion__c &lt;= 0
    )
)</errorConditionFormula>
        <errorDisplayField>MontoEstimadoDeInversion__c</errorDisplayField>
        <errorMessage>El monto debe ser un valor positivo mayor a cero.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PM_OPP_Motivo_Perdida_PM</fullName>
        <active>true</active>
        <description>HU1 PM - RN05 Opportunity: motivo de pérdida abierto obligatorio cuando la Opportunity PM está Closed Lost.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Oportunidad_Personas_Morales&quot;,
    ISPICKVAL(StageName, &quot;Closed Lost&quot;),
    ISBLANK(TEXT(Motivo_de_perdidaPM__c))
)</errorConditionFormula>
        <errorDisplayField>Motivo_de_perdidaPM__c</errorDisplayField>
        <errorMessage>Captura el motivo de pérdida.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PM_OPP_No_Reabrir_Cerrada</fullName>
        <active>true</active>
        <description>HU1 PM - RN04 Opportunity: no permitir reabrir una Opportunity PM cuando ya estaba Closed Won o Closed Lost.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Oportunidad_Personas_Morales&quot;,
    NOT(ISNEW()),
    ISCHANGED(StageName),
    OR(
        ISPICKVAL(PRIORVALUE(StageName), &quot;Closed Won&quot;),
        ISPICKVAL(PRIORVALUE(StageName), &quot;Closed Lost&quot;)
    ),
    NOT(
        OR(
            ISPICKVAL(StageName, &quot;Closed Won&quot;),
            ISPICKVAL(StageName, &quot;Closed Lost&quot;)
        )
    )
)</errorConditionFormula>
        <errorDisplayField>StageName</errorDisplayField>
        <errorMessage>No puedes reabrir una oportunidad cerrada.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PM_OPP_Producto_Requerido</fullName>
        <active>true</active>
        <description>HU1 PM - RV04 Oportunidades: Producto obligatorio para Opportunity PM.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Oportunidad_Personas_Morales&quot;,
    ISBLANK(TEXT(Producto_Solicitado__c))
)</errorConditionFormula>
        <errorDisplayField>Producto_Solicitado__c</errorDisplayField>
        <errorMessage>Selecciona un producto.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PM_OPP_Solo_Owner_Cierra</fullName>
        <active>true</active>
        <description>HU1 PM - RN04 Opportunity: solo el propietario puede cambiar una Opportunity PM a Closed Won o Closed Lost.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Oportunidad_Personas_Morales&quot;,
    NOT(ISNEW()),
    ISCHANGED(StageName),
    OR(
        ISPICKVAL(StageName,&quot;Closed Won&quot;),
        ISPICKVAL(StageName,&quot;Closed Lost&quot;)
    ),
    PRIORVALUE(OwnerId) &lt;&gt; $User.Id,
    $UserRole.DeveloperName &lt;&gt; &quot;Head_PM&quot;
)</errorConditionFormula>
        <errorDisplayField>StageName</errorDisplayField>
        <errorMessage>Solo el propietario puede cerrar la oportunidad.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PatrimNoPuedesCerrarOppGanada</fullName>
        <active>true</active>
        <description>Regla de validación donde no puedes cerrar una oportunidad como ganada sin tener los checks en verdadero</description>
        <errorConditionFormula>AND
(
			
				 ISPICKVAL(StageName, &quot;Cerrada ganada&quot;) ,
				 Patrim_ClienteCreado__c = False,
				 Contrato_Creado__c = False,
				 F3_isCreatedInSAP__c = False,
				 RecordType.Name = &quot;Patrimonial&quot;
				)</errorConditionFormula>
        <errorMessage>No puedes cerrar una oportunidad como ganada sin mandarla a SAP y esperar el proceso correspondiente</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PatrimValidaPresentacionOferta</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISPICKVAL(PRIORVALUE(StageName), &apos;Presentación de oferta&apos;),
    ISCHANGED(StageName),
				ISPICKVAL(StageName, &quot;Solicitar Documentación&quot;),
    ISPICKVAL(Cliente_Acepta_oferta__c, &quot;&quot;),
    RecordType.DeveloperName = &apos;Patrimonial&apos;
)
 || 
	AND(
    ISPICKVAL(PRIORVALUE(StageName), &apos;Presentación de oferta&apos;),
    ISCHANGED(StageName),
				ISPICKVAL(StageName, &quot;Formalización y validación&quot;),
    ISPICKVAL(Cliente_Acepta_oferta__c, &quot;&quot;),
    RecordType.DeveloperName = &apos;Patrimonial&apos;
)
|| 
	AND(
    ISPICKVAL(PRIORVALUE(StageName), &apos;Presentación de oferta&apos;),
    ISCHANGED(StageName),
				ISPICKVAL(StageName, &quot;Solicitar documentación&quot;),
    ISPICKVAL(Cliente_Acepta_oferta__c, &quot;NO&quot;),
					ISPICKVAL( Siguientes_pasos__c, &quot;Cliente no acepta propuesta y desea que se le de seguimiento posteriormente&quot;),
    RecordType.DeveloperName = &apos;Patrimonial&apos;
)
|| 
	AND(
    ISPICKVAL(PRIORVALUE(StageName), &apos;Presentación de oferta&apos;),
    ISCHANGED(StageName),
				ISPICKVAL(StageName, &quot;Formalización y validación&quot;),
    ISPICKVAL(Cliente_Acepta_oferta__c, &quot;NO&quot;),
					ISPICKVAL( Siguientes_pasos__c, &quot;Cliente no acepta propuesta y desea que se le de seguimiento posteriormente&quot;),
    RecordType.DeveloperName = &apos;Patrimonial&apos;
)
|| 
	AND(
    ISPICKVAL(PRIORVALUE(StageName), &apos;Presentación de oferta&apos;),
    ISCHANGED(StageName),
				ISPICKVAL(StageName, &quot;Solicitar documentación&quot;),
    ISPICKVAL(Cliente_Acepta_oferta__c, &quot;NO&quot;),
					ISPICKVAL( Siguientes_pasos__c, &quot;Cliente no acepta propuesta y no tiene interés&quot;),
    RecordType.DeveloperName = &apos;Patrimonial&apos;
)
|| 
	AND(
    ISPICKVAL(PRIORVALUE(StageName), &apos;Presentación de oferta&apos;),
    ISCHANGED(StageName),
				ISPICKVAL(StageName, &quot;Formalización y validación&quot;),
    ISPICKVAL(Cliente_Acepta_oferta__c, &quot;NO&quot;),
					ISPICKVAL( Siguientes_pasos__c, &quot;Cliente no acepta propuesta y no tiene interés&quot;),
    RecordType.DeveloperName = &apos;Patrimonial&apos;
)</errorConditionFormula>
        <errorMessage>Favor de seleccionar una opción, para poder avanzar a la siguiente etapa.
Nota: No podrás avanzar a otra etapa diferente a &apos;Solicitar Documentación&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Patrim_NoPuedesCerrarOppPerdida</fullName>
        <active>true</active>
        <description>Regla de validación para que el asesor complemente los campos antes de cierre la oportunidad como perdida</description>
        <errorConditionFormula>AND(
RecordType.Name = &quot;Patrimonial&quot;,
ISPICKVAL(StageName, &quot;Cerrada Perdida&quot;),
				ISPICKVAL(Motivo_de_p_rdida__c, &quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>Motivo_de_p_rdida__c</errorDisplayField>
        <errorMessage>No puedes cerrar la oportunidad como perdida sin antes complementar los campos Razones por pérdida de oportunidad y Competencia.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Patrim_UnicamenteIdentificarNecesidades</fullName>
        <active>true</active>
        <description>Regla de validación donde solo puede posicionarse en la etapa identificar necesidades cuando se encuentre en recalendarización.</description>
        <errorConditionFormula>AND(
    ISPICKVAL(PRIORVALUE(StageName), &quot;Recalendarización&quot;), 
    OR(
        ISPICKVAL(StageName, &quot;Presentación de oferta&quot;),
        ISPICKVAL(StageName, &quot;Solicitar documentación&quot;),
								ISPICKVAL(StageName, &quot;Formalización y validación&quot;)
								
    )
)</errorConditionFormula>
        <errorMessage>No puedes cambiar a otra etapa que no sea Identificar Necesidades</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PolizaSegurosCreada</fullName>
        <active>true</active>
        <description>El campo No. de póliza de seguros, este campo es obligatorio en caso de seleccionar que se tiene una póliza creada( HU 29)</description>
        <errorConditionFormula>And( Poliza_de_Seguros_Creada__c = true, ISBLANK(F3_No_Poliza_Seguros__c))</errorConditionFormula>
        <errorMessage>Debes completar el campo &quot;No. de Póliza de Seguros&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>REQ_Folio_Apertura_En_Cotizacion</fullName>
        <active>true</active>
        <description>Valida que cuando el campo Etapas Pipeline tenga el valor &quot;E04: EN COTIZACIÓN&quot;, el campo Folio de Apertura sea obligatorio, evitando guardar el registro si está vacío.</description>
        <errorConditionFormula>AND(
  $RecordType.Name = &quot;Seguros Pipeline&quot;,
  ISPICKVAL(Etapas_Pipeline__c, &quot;E04: EN COTIZACIÓN&quot;),
  OR(
    ISBLANK(Folio_Zurich__c),
    LEN(TRIM(Folio_Zurich__c)) = 0
  )
)</errorConditionFormula>
        <errorDisplayField>Folio_Zurich__c</errorDisplayField>
        <errorMessage>Folio de Apertura es obligatorio cuando la etapa es &quot;E04: EN COTIZACIÓN&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>RazonDeLaPerdida_Institucion_Obligat</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
				ISPICKVAL(Razon_de_la_perdida__c, &quot;El cliente se fue con la competencia /contrato con otra institución&quot;),
				ISPICKVAL(Razon_de_la_perdida__c, &quot;Fidelidad a su bróker/Aseguradora actual&quot;)
),
				ISPICKVAL(Institucion__c, &quot;&quot;),
				OR(
        RecordType.DeveloperName = &apos;Financiamiento&apos;,
        RecordType.DeveloperName = &apos;Insurance&apos;
    )
)</errorConditionFormula>
        <errorMessage>Favor de ingresar Institución</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>RecalendarizacionOpp</fullName>
        <active>true</active>
        <errorConditionFormula>AND
(
				
 ISPICKVAL(StageName, &quot;Recalendarización&quot;),
				 ISPICKVAL(Cliente_Acepta_oferta__c, &quot;NO&quot;),
				 ISPICKVAL(Siguientes_pasos__c, &quot;Cliente no acepta propuesta y desea que se le de seguimiento posteriormente&quot;),
				 ISBLANK( Fecha_de_seguimiento__c),
				 RecordType.Name = &quot;Patrimonial&quot;
				) 
				||
				AND(
				 ISPICKVAL(StageName, &quot;Recalendarización&quot;),
     ISCHANGED(StageName),
					ISBLANK( Fecha_de_seguimiento__c),
												 RecordType.Name = &quot;Patrimonial&quot;

					)</errorConditionFormula>
        <errorDisplayField>Fecha_de_seguimiento__c</errorDisplayField>
        <errorMessage>Debes establecer una fecha de seguimiento.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Seguros_NoPermite_Reabrir_Op</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    NOT($Permission.bypassValidationRules),
    NOT(ISNEW()),
    OR(
        RecordType.DeveloperName = &apos;Oportunidad_Personas_Fisicas&apos;,
        RecordType.DeveloperName = &apos;Seguros_Pipeline&apos;,
        RecordType.DeveloperName = &apos;Oportunidad_Seguro_Via&apos;,
        RecordType.DeveloperName = &apos;Oportunidad_Seguro_Hogar&apos;,
        RecordType.DeveloperName = &apos;Oportunidad_Seguro_Dotales&apos;
    ),
    OR(
        ISPICKVAL(PRIORVALUE(StageName), &apos;Cerrada Ganada&apos;),
        ISPICKVAL(PRIORVALUE(StageName), &apos;Cerrada Perdida&apos;)
    ),
    NOT(
        OR(
            ISPICKVAL(StageName, &apos;Cerrada Ganada&apos;),
            ISPICKVAL(StageName, &apos;Cerrada Perdida&apos;)
        )
    )
)</errorConditionFormula>
        <errorMessage>No puedes reabrir la oportunidad: si está cerrada (Ganada o Perdida).</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VF_Estatus_Requerido_Identificar_Necesid</fullName>
        <active>true</active>
        <description>Obliga a seleccionar un valor en el campo Estatus__c cuando el tipo de registro sea Oportunidad_Personas_Fisicas y la etapa (StageName) sea Identificar Necesidades.</description>
        <errorConditionFormula>AND(
    OR(
        RecordType.DeveloperName = &quot;Oportunidad_Personas_Fisicas&quot;,
        RecordType.DeveloperName = &quot;Oportunidad_Seguro_Via&quot;,
        RecordType.DeveloperName = &quot;Oportunidad_Seguro_Hogar&quot;,
        RecordType.DeveloperName = &quot;Oportunidad_Seguro_Dotales&quot;
    ),
    ISCHANGED(StageName),
    ISPICKVAL(PRIORVALUE(StageName), &quot;Identificar Necesidades&quot;),
    NOT( ISPICKVAL(StageName, &quot;Contacto inicial&quot;) ),
    ISBLANK(TEXT(Estatus__c))
)</errorConditionFormula>
        <errorDisplayField>Estatus__c</errorDisplayField>
        <errorMessage>Seleccione una opción en el campo &quot;Estatus&quot; para poder avanzar a la siguiente etapa.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VR_Importe_Obligatorio_SegurosPipeline</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
RecordType.Name = &quot;Seguros Pipeline&quot;,
ISBLANK(Amount)
)</errorConditionFormula>
        <errorDisplayField>Amount</errorDisplayField>
        <errorMessage>El campo Importe es obligatorio para las oportunidades de Seguros Pipeline.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VR_Recalendarizacion_FechaSeguimiento_Ob</fullName>
        <active>true</active>
        <description>Obliga a capturar Fecha de seguimiento cuando la oportunidad (RT Oportunidad_Personas_Fisicas) está en la etapa Recalendarización.</description>
        <errorConditionFormula>AND(
    OR(
        $RecordType.DeveloperName = &apos;Oportunidad_Personas_Fisicas&apos;,
        $RecordType.DeveloperName = &apos;Oportunidad_Seguro_Via&apos;,
        $RecordType.DeveloperName = &apos;Oportunidad_Seguro_Hogar&apos;,
        $RecordType.DeveloperName = &apos;Oportunidad_Seguro_Dotales&apos;
    ),
    ISCHANGED(StageName),
    TEXT(PRIORVALUE(StageName)) = &apos;Identificar Necesidades&apos;,
    ISPICKVAL(StageName, &apos;Recalendarización&apos;),
    ISPICKVAL(Estatus__c, &apos;Aprobado y cupón para fecha renovación&apos;),
    ISBLANK(Fecha_de_seguimiento__c)
)</errorConditionFormula>
        <errorDisplayField>Fecha_de_seguimiento__c</errorDisplayField>
        <errorMessage>Captura la &quot;Fecha de seguimiento&quot; para continuar.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validar_Descripcion_No_Interes</fullName>
        <active>true</active>
        <description>Obliga a capturar el campo &quot;Descripción de No Interés&quot; cuando el motivo seleccionado sea CONDICIONES, OTRO u OTRO INTERMEDIARIO en la oportunidad.</description>
        <errorConditionFormula>AND(
    ISPICKVAL(Motivos_de_interes_No_interes__c, &quot;CONDICIONES&quot;) ||
    ISPICKVAL(Motivos_de_interes_No_interes__c, &quot;OTRO&quot;) ||
    ISPICKVAL(Motivos_de_interes_No_interes__c, &quot;OTRO INTERMEDIARIO&quot;),
    ISBLANK(Descripcion_de_No_Interes__c)
)</errorConditionFormula>
        <errorDisplayField>Descripcion_de_No_Interes__c</errorDisplayField>
        <errorMessage>Este campo es obligatorio cuando selecciones CONDICIONES, OTRO u OTRO INTERMEDIARIO.

Si eliges CONDICIONES: menciona cuáles.

Si eliges OTRO: indica cuál.

Si eliges OTRO INTERMEDIARIO: especifica cuál.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ValidateOwnerVSCurrentUser</fullName>
        <active>false</active>
        <errorConditionFormula>(Account.OwnerId !=  $User.Id)&amp;&amp; ISNEW()</errorConditionFormula>
        <errorMessage>Para realizar la creación de una nueva oportunidad, asegúrese que el cliente esté asignado a usted</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>validarOppCerradaPerdida</fullName>
        <active>true</active>
        <description>RV que valida que al seleccionar la opp en cerrada perdida, deba de seleccionar el motivo de rechazo</description>
        <errorConditionFormula>AND
(
RecordType.Name = &quot;Wealth Management&quot;,
ISPICKVAL(StageName, &apos;Cerrada Perdida&apos;) &amp;&amp;
ISBLANK(TEXT(MotivoDeRechazo__c))
)</errorConditionFormula>
        <errorDisplayField>MotivoDeRechazo__c</errorDisplayField>
        <errorMessage>Debe seleccionar un motivo de rechazo cuando la oportunidad esté cerrada como perdida</errorMessage>
    </validationRules>
</CustomObject>
