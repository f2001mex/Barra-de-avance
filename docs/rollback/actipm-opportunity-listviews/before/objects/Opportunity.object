    <fields>
        <fullName>Is_From_MKT_Calculator__c</fullName>
        <formula>AND(
 CASESAFEID(CreatedById)  =  &quot;0055e000005hqg7AAA&quot;,
 NOT(CASESAFEID(Account.OwnerId) = &quot;0055e0000078BbjAAE&quot;),
 OR( 
    RecordType.DeveloperName  =  &quot;Planes_Beneficio_Fiscal&quot;,
    RecordType.DeveloperName  =  &quot;WalletShareOpportunity&quot;
 ) 
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Calculadora MKT</label>
