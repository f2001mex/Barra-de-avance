/**
 *   ------------------------------------------------------------------------------------------------
 * @name     F4_Lead_Facebook_Batch
 * @author   jonas.montoya.landa@pwc.com
 * @date     Created: July 11 2023
 * ------------------------------------------------------------------------------------------------
 * @description Batchable class that uses Facebook Leads Optimization service.
 * 				This class reports Leads' status advance in the lead process, right from starting status
 * 				to conversion success/failure, and all statuses in between.
 * 				This class should be invoked from a schedulable class every fixed period of time and
 * 				in batches of maximum 1000 records as per API specification (Facebook Conversions API).
 * 				Alternatively, class can be manually invoked by specifying datetime ranges for batch query
 * 				(see F4_Lead_Facebook_BatchHelper.getQuery(Datetime, Datetime)).	
 * ------------------------------------------------------------------------------------------------
 * @changes		July 11 2023 jonas.montoya.landa@pwc.com Class Creation
 * ------------------------------------------------------------------------------------------------
 **/
public without sharing class F4_Lead_Facebook_Batch implements Database.Batchable<sObject>, Database.AllowsCallouts {
    
    /*
     * @description Batch string query.
     */
    private String query;
    
    /*
     * @description Start datetime of batch execution in order to filter records that
     * 				were modified/created since (inclusive)
     * 				This field should be specified in constructor method when there is
     * 				no schedulable class that calls batch execution e.g. from an
     * 				anonymous block of code, another class, etc.
     */
    private Datetime startDt;
    
    /*
     * @description End datetime of batch execution in order to filter records that
     * 				were modified/created before (exclusive)
     * 				This field should be specified in constructor method when there is
     * 				no schedulable class that calls batch execution e.g. from an
     * 				anonymous block of code, another class, etc.
     */
    private Datetime endDt;
    
    /** ------------------------------------------------------------------------------------------------
	 * @description Class constructor with batch query.
	 * 				F4_Lead_Facebook_BatchHelper.getQuery(ID) or F4_Lead_Facebook_BatchHelper.getQuery(Datetime, Datetime)
	 * 				should be used to construct the query
	 * ------------------------------------------------------------------------------------------------
	 * @author   jonas.montoya.landa@pwc.com
	 * @date     July 11 2023
	 * @param 	 String
	 * @return   -
	 * @example  Database.executeBatch(new F4_Lead_Facebook_Batch(F4_Lead_Facebook_BatchHelper.getQuery(schedJobID)))
	 * ------------------------------------------------------------------------------------------------*
	*/
    public F4_Lead_Facebook_Batch (String query) {
        this.query = query;
    }
    
    /** ------------------------------------------------------------------------------------------------
	 * @description Class constructor with start and end datetime range for batch query
	 * 				This constructor can be used when there is no schedulable class that invokes this method
	 * 				and manual execution is done instead. Query string is then generated by
	 * 				F4_Lead_Facebook_BatchHelper.getQuery(Datetime, Datetime)
	 * ------------------------------------------------------------------------------------------------
	 * @author   jonas.montoya.landa@pwc.com
	 * @date     July 11 2023
	 * @param 	 Datetime Start datetime of range
	 * @param	 Datetime End datetime of range
	 * @return   -
	 * @example  Database.executeBatch(new F4_Lead_Facebook_Batch(startDt, endDt))
	 * ------------------------------------------------------------------------------------------------*
	*/
    public F4_Lead_Facebook_Batch (Datetime startDt, Datetime endDt) {
        
        this.startDt = startDt;
        this.endDt = endDt;
    }
     
    /** ------------------------------------------------------------------------------------------------
	 * @description Override method of batch interface.
	 * 				Gets batch query based on existence of this same attribute
	 * 				or retrieves it from specified datetime range attributes
	 * ------------------------------------------------------------------------------------------------
	 * @author   jonas.montoya.landa@pwc.com
	 * @date     July 11 2023
	 * @param 	 Database.BatchableContext
	 * @return   Database.QueryLocator
	 * @example  Managed by batch execution
	 * ------------------------------------------------------------------------------------------------*
	*/
    public Database.QueryLocator start (Database.BatchableContext bc) {
        
        return String.isNotEmpty(query) ?
               Database.getQueryLocator(query) :
        	   Database.getQueryLocator(F4_Lead_Facebook_BatchHelper.getQuery(startDt, endDt));
    }

    /** ------------------------------------------------------------------------------------------------
	 * @description Override method of batch interface.
	 * 				Makes a callout to Facebook Conversions API in order to report leads that advanced
	 * 				in its lead process
	 * ------------------------------------------------------------------------------------------------
	 * @author   jonas.montoya.landa@pwc.com
	 * @date     July 11 2023
	 * @param 	 Database.BatchableContext
	 * @param	 List<sObject>
	 * @return   void
	 * @example  Managed by batch execution
	 * ------------------------------------------------------------------------------------------------*
	*/
    public void execute (Database.BatchableContext bc, List<sObject> scope) {
        
        if (scope.isEmpty()) {
            return;
        }
       
        try {
        	Integration_Service.ServiceResponse response = Integration_Service.calloutService(
           		F4_Lead_Facebook_BatchHelper.getMdtServiceName(),
           		F4_Lead_Facebook_BatchHelper.buildJSON(scope),
           		null,
           		null,
           		false
       		);
        }
        catch (Exception e) {
            F4_Lead_Facebook_BatchHelper.handleException(e, F4_Lead_Facebook_BatchHelper.getMdtServiceName());
        }
    }
    
    /** ------------------------------------------------------------------------------------------------
	 * @description Override method of batch interface.
	 * 				Not any operation
	 * ------------------------------------------------------------------------------------------------
	 * @author   jonas.montoya.landa@pwc.com
	 * @date     July 11 2023
	 * @param 	 Database.BatchableContext
	 * @return   void
	 * @example  Managed by batch execution
	 * ------------------------------------------------------------------------------------------------*
	*/
    public void finish (Database.BatchableContext bc) {
        
    }
	
}