            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OpportunityPMDraft.Producto_Solicitado__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Otro</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Especifica_Otro</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Especifica_Otro</targetReference>
            </connector>
            <label>Producto Otro sin especificar</label>
        </rules>
        <rules>
            <name>Monto_No_Valido</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Monto</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Monto</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Monto</targetReference>
            </connector>
            <label>Monto no válido</label>
        </rules>
        <rules>
            <name>Probabilidad_No_Valida</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Probabilidad</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Probabilidad</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Probabilidad</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>100.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Probabilidad</targetReference>
            </connector>
            <label>Probabilidad no válida</label>
        </rules>
        <rules>
            <name>Fecha_Cierre_No_Valida</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Fecha_Cierre</leftValueReference>
                <operator>LessThan</operator>
