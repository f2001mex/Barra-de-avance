<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PM_ACC_BP_Requerido</fullName>
    <active>false</active>
    <description>HU1 PM - RV02 Clientes: Numero de cliente / BP obligatorio para Account PM.</description>
    <errorConditionFormula>AND(
    OR(
        RecordType.DeveloperName = &quot;IndustriesBusiness&quot;,
        RecordType.DeveloperName = &quot;Cuentas_empresariales&quot;
    ),
    ISBLANK(Client_ID__c)
)</errorConditionFormula>
    <errorDisplayField>Client_ID__c</errorDisplayField>
    <errorMessage>Captura el Número de Cliente / BP.</errorMessage>
</ValidationRule>
