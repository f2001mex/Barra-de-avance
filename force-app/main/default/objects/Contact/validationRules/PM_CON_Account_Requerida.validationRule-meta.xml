<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PM_CON_Account_Requerida</fullName>
    <active>true</active>
    <description>HU1 PM - RV01 Contactos: Cliente asociado obligatorio para Contact PM.</description>
    <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;IndustriesBusiness&quot;,
    ISBLANK(AccountId)
)</errorConditionFormula>
    <errorDisplayField>AccountId</errorDisplayField>
    <errorMessage>Relaciona el contacto con un cliente.</errorMessage>
</ValidationRule>
