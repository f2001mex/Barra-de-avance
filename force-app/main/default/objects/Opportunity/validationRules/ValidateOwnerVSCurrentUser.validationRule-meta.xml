<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ValidateOwnerVSCurrentUser</fullName>
    <active>false</active>
    <errorConditionFormula>(Account.OwnerId !=  $User.Id)&amp;&amp; ISNEW()</errorConditionFormula>
    <errorMessage>Para realizar la creación de una nueva oportunidad, asegúrese que el cliente esté asignado a usted</errorMessage>
</ValidationRule>
