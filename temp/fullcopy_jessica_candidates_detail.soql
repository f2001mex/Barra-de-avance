SELECT Id, Name, BanqueroAsignado__c, Segmento__c, SaldoIntegral__c, FechaSiguienteContacto__c, FechaSiguienteVisita__c, ContactoPriorizadoEsteMes__c,
TYPEOF BanqueroAsignado__r.BusinessUnitMember
WHEN Banker THEN Id, Name, ExternalId__c, Division__c, Cargo__c
END
FROM Account
WHERE ID_Asesor__c = '65035'
AND Person_Type__c = 'FISICA'
AND Segmento__c = 'Patrimonial reactivo'
AND SaldoIntegral__c >= 300000
AND SaldoIntegral__c <= 999999999
AND FechaSiguienteContacto__c != null
AND FechaSiguienteVisita__c != null
AND ((FechaSiguienteContacto__c <= THIS_MONTH) OR (FechaSiguienteVisita__c <= THIS_MONTH))
ORDER BY SaldoIntegral__c DESC
LIMIT 50
