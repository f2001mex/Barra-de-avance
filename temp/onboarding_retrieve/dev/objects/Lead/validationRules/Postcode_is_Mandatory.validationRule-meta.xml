<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Postcode_is_Mandatory</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISBLANK(PostalCode),
    NOT(RecordType.DeveloperName = &apos;Seguros&apos;),
    NOT(RecordType.DeveloperName = &apos;Seguros_Prospecto&apos;)
    )</errorConditionFormula>
    <errorDisplayField>PostalCode</errorDisplayField>
    <errorMessage>Postcode is required</errorMessage>
</ValidationRule>
