    <description>Flojo que ayuda a el cálculo de avance de llenado de Ficha de Afinidad del Cliente</description>
    <environments>Default</environments>
    <formulas>
        <name>b_InfluyeEsNoAplica</name>
        <dataType>Boolean</dataType>
        <expression>INCLUDES({!$Record.Alguien_InfluyeEnTuPatrimonio__c}, &quot;No aplica&quot;)</expression>
    </formulas>
    <formulas>
        <name>b_SegurosEsNoAplica</name>
        <dataType>Boolean</dataType>
        <expression>INCLUDES({!$Record.Conquetipodeseguroscuentas__c}, &quot;No aplica&quot;)</expression>
    </formulas>
    <formulas>
        <name>f_AplicaEdad1</name>
        <dataType>Number</dataType>
        <expression>IF({!fn_NumHijos} &gt;= 1, 1, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_AplicaEdad2</name>
        <dataType>Number</dataType>
        <expression>IF({!fn_NumHijos} &gt;= 2, 1, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_AplicaEdad3</name>
        <dataType>Number</dataType>
        <expression>IF({!fn_NumHijos} &gt;= 3, 1, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_AplicaEdad4</name>
        <dataType>Number</dataType>
        <expression>IF({!fn_NumHijos} &gt;= 4, 1, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_AplicaEdad5</name>
        <dataType>Number</dataType>
        <expression>IF({!fn_NumHijos} &gt;= 5, 1, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_CuandoVence</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!$Record.CuandoVence__c}), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_EmpresaAseg</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!$Record.Conqueempresaestasasegurado__c}), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_EstudiaFuera</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK(TEXT({!$Record.Estudiaoestudianfueradelpais__c})), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_FamiliarAct</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK(TEXT({!$Record.FamiliarqueseaclienteenActinver__c})), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_Frecuencia</name>
        <dataType>Number</dataType>
        <expression>IF(
  OR(
    ISBLANK(TEXT({!$Record.Frecuencia_para_ser_contactado__c})),
    TEXT({!$Record.Frecuencia_para_ser_contactado__c})=&quot;--None--&quot;
  ),
  0, 1
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_Gastos</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!$Record.Gastos_mensuales__c}), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_Hijos</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK(TEXT({!$Record.Cuantos_hijos_tienes__c})), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_Influye</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!$Record.Alguien_InfluyeEnTuPatrimonio__c}), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_Ingreso</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!$Record.Ingreso_mensual_despu_s_de_impuestos__c}), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_Institucion</name>
        <dataType>Number</dataType>
        <expression>IF(
  OR(
    ISBLANK(TEXT({!$Record.InstitucionFinancieraPrincipal__c})),
    TEXT({!$Record.InstitucionFinancieraPrincipal__c}) = &quot;--None--&quot;
  ),
  0,
  1
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_LlenaEdad1</name>
        <dataType>Number</dataType>
        <expression>IF(
  {!fn_NumHijos} &gt;= 1 &amp;&amp;
  NOT(ISBLANK(TEXT({!$Record.Edadprimerhijo__c}))),
  1, 0
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_LlenaEdad2</name>
        <dataType>Number</dataType>
        <expression>IF(
  {!fn_NumHijos} &gt;= 2 &amp;&amp;
  NOT(ISBLANK(TEXT({!$Record.Edadsegundohijo__c}))),
  1, 0
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_LlenaEdad3</name>
        <dataType>Number</dataType>
        <expression>IF(
  {!fn_NumHijos} &gt;= 3 &amp;&amp;
  NOT(ISBLANK(TEXT({!$Record.Edadtercerhijo__c}))),
  1, 0
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_LlenaEdad4</name>
        <dataType>Number</dataType>
        <expression>IF(
  {!fn_NumHijos} &gt;= 4 &amp;&amp;
  NOT(ISBLANK(TEXT({!$Record.Edadcuartohijo__c}))),
  1, 0
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_LlenaEdad5</name>
        <dataType>Number</dataType>
        <expression>IF(
  {!fn_NumHijos} &gt;= 5 &amp;&amp;
  NOT(ISBLANK(TEXT({!$Record.Edadquintohijo__c}))),
  1, 0
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_MedioPreferido</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!$Record.MedioPreferidoContacto__c}), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_MesPreferente</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!$Record.MesPreferenteInversion_o_ahorrar__c}), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_NombreFamiliar</name>
        <dataType>Number</dataType>
        <expression>IF(
  ISBLANK({!$Record.Nombredelfamiliar__c}),
  0,
  1
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_OtrosProd</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!$Record.Otrosproductosfinancierosteinteresan__c}), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_Pasatiempo</name>
        <dataType>Number</dataType>
        <expression>IF(
  OR(
    ISBLANK(TEXT({!$Record.Pasatiempo__c})),
    TEXT({!$Record.Pasatiempo__c})=&quot;--None--&quot;
  ),
  0, 1
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_PatrimonioAct</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!$Record.depatrimoniofinancierototalenActinver__c}), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_Porque</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!$Record.PorqueIndentInteres__c}), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_PrincipalAct</name>
        <dataType>Number</dataType>
        <expression>IF(
  OR(
    ISBLANK(TEXT({!$Record.PrincipalActividadProfesional__c})),
    TEXT({!$Record.PrincipalActividadProfesional__c})=&quot;--None--&quot;
  ),
  0, 1
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_Redes</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!$Record.Queredessocialesutilizas__c}), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_ReferidoAccount</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!$Record.Agrega_un_referido__c}), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_ReferidoContact</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!$Record.FinServ__ReferredByContact__c}), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_TipoSeguros</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!$Record.Conquetipodeseguroscuentas__c}), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_Viajas</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK(TEXT({!$Record.Viajas_recurrentemente__c})), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fb_ClienteRelacionadoLleno</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  NOT(ISBLANK(TEXT({!$Record.Cliente_relacionado__c}))),
  TEXT({!$Record.Cliente_relacionado__c}) &lt;&gt; &quot;--None--&quot;
)</expression>
    </formulas>
    <formulas>
        <name>fb_RedesIncluyeOtros</name>
        <dataType>Boolean</dataType>
        <expression>INCLUDES({!$Record.Queredessocialesutilizas__c}, &quot;Otros&quot;)</expression>
    </formulas>
    <formulas>
        <name>fn_AplicaEdadesTotal</name>
        <dataType>Number</dataType>
        <expression>IF(
  OR(
    ISBLANK(TEXT({!$Record.Cuantos_hijos_tienes__c})),
    TEXT({!$Record.Cuantos_hijos_tienes__c}) = &quot;No aplica&quot;
  ),
  0,
  IF(TEXT({!$Record.Cuantos_hijos_tienes__c}) = &quot;1&quot;, 1,
    IF(TEXT({!$Record.Cuantos_hijos_tienes__c}) = &quot;2&quot;, 2,
      IF(TEXT({!$Record.Cuantos_hijos_tienes__c}) = &quot;3&quot;, 3, 0)
    )
  )
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fn_LlenasEdadesTotal</name>
        <dataType>Number</dataType>
        <expression>IF(
  OR(
    ISBLANK(TEXT({!$Record.Cuantos_hijos_tienes__c})),
    TEXT({!$Record.Cuantos_hijos_tienes__c}) = &quot;No aplica&quot;
  ),
  0,
  IF(NOT(ISBLANK(TEXT({!$Record.Edadprimerhijo__c}))),1,0) +
  IF(
    OR(
      TEXT({!$Record.Cuantos_hijos_tienes__c}) = &quot;2&quot;,
      TEXT({!$Record.Cuantos_hijos_tienes__c}) = &quot;3&quot;
    ),
    IF(NOT(ISBLANK(TEXT({!$Record.Edadsegundohijo__c}))),1,0),
    0
  ) +
  IF(
    TEXT({!$Record.Cuantos_hijos_tienes__c}) = &quot;3&quot;,
    IF(NOT(ISBLANK(TEXT({!$Record.Edadtercerhijo__c}))),1,0),
    0
  )
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fn_NumHijos</name>
        <dataType>Number</dataType>
        <expression>IF(
  ISBLANK(TEXT({!$Record.Cuantos_hijos_tienes__c})),
  0,
  VALUE(TEXT({!$Record.Cuantos_hijos_tienes__c}))
)</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Flow_Avance_FAC {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Flow_Avance_FAC</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Aplicables</targetReference>
        </connector>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>vAplicables</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>vLlenos</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
</Flow>
